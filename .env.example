# Modelo do .env do frontend (o .env real está no .gitignore).
#
#   cp .env.example .env
#
# Qual das duas entra no bundle depende do comando, não de onde a app roda:
#   npm run dev   -> VITE_DEV_API_BASEURL
#   npm run build -> VITE_PROD_API_BASEURL   (é o que o dockerfile executa)

# API rodando na máquina via ./mvnw spring-boot:run
VITE_DEV_API_BASEURL=http://localhost:8080

# API do docker compose. No build da imagem, o compose sobrescreve este valor
# passando VITE_PROD_API_BASEURL como build arg.
VITE_PROD_API_BASEURL=http://localhost:8081
